# ===========================================
# CONVEX CONFIGURATION
# ===========================================

# Your Convex deployment URL (get this from https://dashboard.convex.dev)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Deploy key for production deployments (create at https://dashboard.convex.dev/project/settings#production-deploy-keys)
# Required for Docker builds to deploy Convex functions
CONVEX_DEPLOY_KEY=

# ===========================================
# STACK AUTH CONFIGURATION
# ===========================================

# Stack Auth Project ID (get this from https://app.stack-auth.com)
NEXT_PUBLIC_STACK_PROJECT_ID=

# Stack Auth Publishable Key
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=

# Stack Auth Secret Key (for server-side operations)
STACK_SECRET_SERVER_KEY=

# ===========================================
# AUTOMATED LISTING IMPORTS (CONVEX RUNTIME)
# ===========================================

# Optional. Without this, the importer falls back to basic HTML metadata.
FIRECRAWL_API_KEY=

# Only set this for a self-hosted Firecrawl instance.
# FIRECRAWL_API_URL=https://your-firecrawl-instance.example.com

# One MCP client:
DIRECTORY_MCP_API_KEY=

# Or multiple named clients as JSON. Each name is stored as the submitter identity.
# DIRECTORY_MCP_API_KEYS={"agenthub":"replace-with-a-long-secret","partner-a":"replace-with-another-secret"}
